.env
.env.*
!.env.example
*.pem
*.key
auth.json
credentials.json
hermes-state/
backups/
*.tar
*.tar.gz
__pycache__/
*.pyc
# Engine integration state and private source snapshot
job-state/
channel-state/
engine/source/
engine.env
engine/build-provenance.json
